{
  "name": "dynamic-skills",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "build": "pnpm --filter @dynamic-skills/cli build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^50.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
