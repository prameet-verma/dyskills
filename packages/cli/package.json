{
  "name": "dynamic-skills",
  "version": "0.1.0",
  "description": "Just-in-time agent skills: assess a task, gather evidence and activate an ephemeral skill for any coding-agent harness.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "cli",
    "skills"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prameet-verma/dyskills.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/prameet-verma/dyskills#readme",
  "bugs": {
    "url": "https://github.com/prameet-verma/dyskills/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "dynamic-skills": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsx scripts/copy-skills.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dynamic-skills/activation": "workspace:*",
    "@dynamic-skills/adapter-claude-code": "workspace:*",
    "@dynamic-skills/adapter-codex": "workspace:*",
    "@dynamic-skills/adapter-opencode": "workspace:*",
    "@dynamic-skills/adapter-sdk": "workspace:*",
    "@dynamic-skills/bootstrapper": "workspace:*",
    "@dynamic-skills/clarification-manager": "workspace:*",
    "@dynamic-skills/context-analyzer": "workspace:*",
    "@dynamic-skills/context-packet": "workspace:*",
    "@dynamic-skills/core": "workspace:*",
    "@dynamic-skills/discovery": "workspace:*",
    "@dynamic-skills/eval-engine": "workspace:*",
    "@dynamic-skills/evidence-registry": "workspace:*",
    "@dynamic-skills/skill-compiler": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
