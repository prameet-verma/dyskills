{
  "$id": "dynamic-skills/v1/clarification-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "questions": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "requirement": {
            "type": "string",
            "maxLength": 200
          },
          "evidenceKey": {
            "type": "string"
          },
          "material": {
            "type": "boolean"
          },
          "blocking": {
            "type": "boolean"
          },
          "options": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "pattern": "^[^;]+$"
                },
                "description": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "label",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "multiSelect": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "requirement",
          "material",
          "blocking"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "questions"
  ],
  "additionalProperties": false
}
