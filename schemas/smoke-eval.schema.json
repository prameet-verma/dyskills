{
  "$id": "dynamic-skills/v1/smoke-eval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "expectedBehaviour": {
      "type": "string"
    },
    "requiredOutputs": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assertions": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "contains",
              "not-contains",
              "regex",
              "not-regex"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "rubric": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "scenario",
    "expectedBehaviour",
    "requiredOutputs",
    "prohibited",
    "assertions",
    "rubric"
  ],
  "additionalProperties": false
}
