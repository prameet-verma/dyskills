{
  "$id": "dynamic-skills/v1/assumptions-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "maxLength": 1000
          },
          "question": {
            "type": "string",
            "maxLength": 1000
          },
          "assumption": {
            "type": "string",
            "maxLength": 1000
          },
          "basis": {
            "type": "string",
            "maxLength": 1000
          },
          "impact": {
            "type": "string",
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "declined",
              "skipped",
              "unanswered",
              "not-asked"
            ]
          }
        },
        "required": [
          "questionId",
          "question",
          "assumption",
          "basis",
          "impact",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "items"
  ],
  "additionalProperties": false
}
