{
  "$id": "dynamic-skills/v1/context-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "action": {
      "type": "string",
      "const": "request_context"
    },
    "requests": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "source_file",
              "configuration",
              "documentation",
              "test_file"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "type",
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "action",
    "requests"
  ],
  "additionalProperties": false
}
