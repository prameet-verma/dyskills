{
  "$id": "dynamic-skills/v1/skills-scan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "personal"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "scope",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "instructionFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "skills",
    "instructionFiles",
    "warnings"
  ],
  "additionalProperties": false
}
