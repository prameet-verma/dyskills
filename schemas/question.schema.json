{
  "$id": "dynamic-skills/v1/question.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "maxLength": 1000
    },
    "requirement": {
      "type": "string",
      "maxLength": 200
    },
    "evidenceKey": {
      "type": "string"
    },
    "material": {
      "type": "boolean"
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "text",
    "requirement",
    "material",
    "blocking"
  ],
  "additionalProperties": false
}
