{
  "$id": "dynamic-skills/v1/session-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "suggest",
        "manual"
      ]
    },
    "explicit": {
      "type": "boolean"
    },
    "repo": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "assessing",
        "discovering",
        "analysing",
        "generating",
        "evaluating",
        "waiting-for-clarification",
        "waiting-for-approval",
        "resuming",
        "activating",
        "completed",
        "warning",
        "timeout",
        "failed"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "sla": {
      "type": "object",
      "properties": {
        "budgetMs": {
          "type": "number"
        },
        "activeMs": {
          "type": "number"
        },
        "paused": {
          "type": "boolean"
        },
        "segmentStartedAt": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "budgetMs",
        "activeMs",
        "paused",
        "segmentStartedAt"
      ],
      "additionalProperties": false
    },
    "completedSteps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarification": {
      "type": "object",
      "properties": {
        "round": {
          "type": "number"
        },
        "asked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "text": {
                "type": "string",
                "maxLength": 1000
              },
              "requirement": {
                "type": "string",
                "maxLength": 200
              },
              "evidenceKey": {
                "type": "string"
              },
              "material": {
                "type": "boolean"
              },
              "blocking": {
                "type": "boolean"
              },
              "options": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60,
                      "pattern": "^[^;\\r\\n]+$"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "label",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "multiSelect": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "text",
              "requirement",
              "material",
              "blocking"
            ],
            "additionalProperties": false
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "text": {
                "type": "string",
                "maxLength": 1000
              },
              "requirement": {
                "type": "string",
                "maxLength": 200
              },
              "evidenceKey": {
                "type": "string"
              },
              "material": {
                "type": "boolean"
              },
              "blocking": {
                "type": "boolean"
              },
              "options": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60,
                      "pattern": "^[^;\\r\\n]+$"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "label",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "multiSelect": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "text",
              "requirement",
              "material",
              "blocking"
            ],
            "additionalProperties": false
          }
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "answered",
                  "declined",
                  "skipped"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 2000
              },
              "assumption": {
                "type": "object",
                "properties": {
                  "assumption": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "basis": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "impact": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "assumption",
                  "basis",
                  "impact"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "questionId",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "round",
        "asked",
        "pending",
        "answers"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "maxLength": 1000
          },
          "question": {
            "type": "string",
            "maxLength": 1000
          },
          "assumption": {
            "type": "string",
            "maxLength": 1000
          },
          "basis": {
            "type": "string",
            "maxLength": 1000
          },
          "impact": {
            "type": "string",
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "declined",
              "skipped",
              "unanswered",
              "not-asked"
            ]
          }
        },
        "required": [
          "questionId",
          "question",
          "assumption",
          "basis",
          "impact",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "language",
              "runtime",
              "package-manager",
              "framework",
              "database",
              "monorepo",
              "testing",
              "build",
              "ci",
              "architecture",
              "conventions",
              "semantic",
              "user"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "needs-investigation",
              "missing",
              "conflicting"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "none",
              "inspect",
              "ask"
            ]
          },
          "evidenceKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "material": {
            "type": "boolean"
          }
        },
        "required": [
          "requirement",
          "category",
          "status",
          "resolution",
          "evidenceKeys",
          "material"
        ],
        "additionalProperties": false
      }
    },
    "blockedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evalAttempts": {
      "type": "number"
    },
    "skillName": {
      "type": "string"
    },
    "evaluatedBundleSha256": {
      "type": "string"
    },
    "requirements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "language",
              "runtime",
              "package-manager",
              "framework",
              "database",
              "monorepo",
              "testing",
              "build",
              "ci",
              "architecture",
              "conventions",
              "semantic",
              "user"
            ]
          },
          "description": {
            "type": "string"
          },
          "humanOnly": {
            "type": "boolean"
          },
          "material": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "category",
          "description",
          "humanOnly",
          "material"
        ],
        "additionalProperties": false
      }
    },
    "sufficiency": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "sufficient",
                "partial",
                "insufficient"
              ]
            },
            "baseSkill": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "path": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "baseInstructionFile": {
              "type": [
                "string",
                "null"
              ]
            },
            "approval": {
              "type": "string",
              "enum": [
                "not-required",
                "pending",
                "approved",
                "declined"
              ]
            }
          },
          "required": [
            "outcome",
            "baseSkill",
            "baseInstructionFile",
            "approval"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wallStartedAt": {
          "type": "number"
        },
        "stageMs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "assessment",
              "discovery",
              "analysis",
              "clarification",
              "compilation",
              "evaluation",
              "activation"
            ]
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "humanWaitMs": {
          "type": "number"
        },
        "llmInteractions": {
          "type": "number"
        },
        "parallelOps": {
          "type": "number"
        },
        "cacheHits": {
          "type": "number"
        },
        "cacheLookups": {
          "type": "number"
        },
        "evaluationMs": {
          "type": "number"
        },
        "activationMs": {
          "type": "number"
        },
        "contextRequests": {
          "default": 0,
          "type": "number"
        },
        "contextRequestRounds": {
          "default": 0,
          "type": "number"
        },
        "analysisSubmissions": {
          "default": 0,
          "type": "number"
        },
        "packetTokens": {
          "default": 0,
          "type": "number"
        },
        "analysisStartedAtActiveMs": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "analysisBaselineMs": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "lastCommandEndedAtActiveMs": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "activated",
            "augmented",
            "reused",
            "timeout",
            "failed",
            "skipped"
          ]
        }
      },
      "required": [
        "wallStartedAt",
        "stageMs",
        "humanWaitMs",
        "llmInteractions",
        "parallelOps",
        "cacheHits",
        "cacheLookups",
        "evaluationMs",
        "activationMs",
        "contextRequests",
        "contextRequestRounds",
        "analysisSubmissions",
        "packetTokens",
        "analysisStartedAtActiveMs",
        "analysisBaselineMs",
        "lastCommandEndedAtActiveMs"
      ],
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "opencode"
          ]
        },
        "dir": {
          "type": "string"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "placedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "harness",
        "dir",
        "manifestSha256",
        "placedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "task",
    "mode",
    "explicit",
    "repo",
    "revision",
    "status",
    "createdAt",
    "sla",
    "completedSteps",
    "clarification",
    "assumptions",
    "gaps",
    "blockedBy",
    "evalAttempts",
    "requirements",
    "sufficiency",
    "metrics"
  ],
  "additionalProperties": false
}
