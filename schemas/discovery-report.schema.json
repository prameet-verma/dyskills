{
  "$id": "dynamic-skills/v1/discovery-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "programmaticMs": {
      "type": "number"
    },
    "agenticMs": {
      "type": "number"
    },
    "contextRequests": {
      "type": "number"
    },
    "contextRequestRounds": {
      "type": "number"
    },
    "analysisSubmissions": {
      "type": "number"
    },
    "packetTokens": {
      "type": "number"
    },
    "evidenceByOrigin": {
      "type": "object",
      "properties": {
        "programmatic": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "agentic": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "user": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "programmatic",
        "agentic",
        "user"
      ],
      "additionalProperties": false
    },
    "programmaticFactShare": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "detectorErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "detector": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "detector",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "indexTruncated": {
              "type": "boolean"
            },
            "depthLimited": {
              "type": "boolean"
            },
            "filesIndexed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "skippedDirs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "secretPolicy": {
              "type": "string"
            },
            "detectorErrors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "detector": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "detector",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "detectorsNotRun": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excerptsDropped": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "indexTruncated",
            "depthLimited",
            "filesIndexed",
            "skippedDirs",
            "secretPolicy",
            "detectorErrors",
            "detectorsNotRun",
            "excerptsDropped"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "programmaticMs",
    "agenticMs",
    "contextRequests",
    "contextRequestRounds",
    "analysisSubmissions",
    "packetTokens",
    "evidenceByOrigin",
    "programmaticFactShare",
    "detectorErrors",
    "limitations"
  ],
  "additionalProperties": false
}
